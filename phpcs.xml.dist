<?xml version="1.0"?>
<ruleset name="SaitoFAQ">
    <description>Règles de code pour le plugin Saito FAQ</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- Sécurité : échappement, sanitisation, nonces -->
    <rule ref="WordPress.Security"/>

    <!-- Internationalisation -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="saito-faq"/>
            </property>
        </properties>
    </rule>

    <!-- Bonnes pratiques d'enregistrement des scripts/styles -->
    <rule ref="WordPress.WP.EnqueuedResources"/>

    <!-- Fonctions de debug oubliées -->
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>

    <!-- Préfixe obligatoire pour toutes les fonctions/constantes/options globales.
         "saito_panel" (includes/saito-panel.php) : panneau produit partagé
         avec le plugin compagnon Saito Navi (son module Stories s'y accroche
         via saito_panel_get_tabs() et le filtre saito_panel_tabs). -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="saito_faq"/>
                <element value="SAITO_FAQ"/>
                <element value="saito_panel"/>
            </property>
        </properties>
    </rule>
</ruleset>
