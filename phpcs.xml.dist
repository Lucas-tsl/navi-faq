<?xml version="1.0"?>
<ruleset name="NaviFAQ">
    <description>Règles de code pour le plugin Navi FAQ</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- Sécurité : échappement, sanitisation, nonces -->
    <rule ref="WordPress.Security"/>

    <!-- Internationalisation -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="navi-faq"/>
            </property>
        </properties>
    </rule>

    <!-- Bonnes pratiques d'enregistrement des scripts/styles -->
    <rule ref="WordPress.WP.EnqueuedResources"/>

    <!-- Fonctions de debug oubliées -->
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>

    <!-- Préfixe obligatoire pour toutes les fonctions/constantes/options globales.
         "navi" (sans "_faq") en plus de "navi_faq" : le panneau produit
         "Navi" (includes/navi-panel.php) et son filtre
         navi_product_panel_tabs sont une API volontairement partagée,
         pensée pour que d'autres plugins de la famille Navi (ex. Stories,
         plugin compagnon Saito Navi) puissent s'y greffer — un préfixe
         navi_faq_ y serait trompeur. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="navi_faq"/>
                <element value="NAVI_FAQ"/>
                <element value="navi_panel"/>
                <element value="navi_product_panel"/>
            </property>
        </properties>
    </rule>
</ruleset>
